{
  "name": "pranamap-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "i18n:export": "node scripts/i18n-export.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "budget": "node scripts/bundle-budget.mjs",
    "dev:phone": "cross-env PRANAMAP_PHONE=1 vite",
    "preview:phone": "npm run build && cross-env PRANAMAP_PHONE=1 vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@huggingface/transformers": "^4.3.2",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^14.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.13.0",
    "onnxruntime-web": "^1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
