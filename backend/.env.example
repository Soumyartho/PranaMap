# Copy to backend/.env and fill in what you have. Every setting has a safe local default: with an empty
# file the app runs fully, with simulated messages, mock ABHA checks and on-phone speech only.
# Never commit backend/.env (it is git-ignored).

# --- Core -----------------------------------------------------------------------------------------
PRANAMAP_JWT_SECRET=change-me-to-a-long-random-string
# PRANAMAP_DATABASE_URL=postgresql+psycopg://pranamap:pranamap@localhost:5432/pranamap
# Demo controls (one-tap demo logins, fast-forward clock). Set false anywhere real.
PRANAMAP_DEMO_MODE=true
# PRANAMAP_CORS_ORIGINS=["https://pranamap.example.org"]

# --- Bhashini speech recognition (online fallback when the phone has no offline model) -----------
# Register at https://bhashini.gov.in/ulca → profile → generate API key.
# PRANAMAP_BHASHINI_USER_ID=
# PRANAMAP_BHASHINI_API_KEY=

# --- Patient and staff messages -------------------------------------------------------------------
# console = record as "simulated", send nothing. twilio | exotel = real SMS.
PRANAMAP_SMS_PROVIDER=console
# Indian SMS needs DLT registration: your principal entity ID, and each template in
# app/integrations/messaging/templates.py registered with its DLT template ID.
# PRANAMAP_DLT_ENTITY_ID=
# PRANAMAP_TWILIO_ACCOUNT_SID=
# PRANAMAP_TWILIO_AUTH_TOKEN=
# PRANAMAP_TWILIO_FROM=
# PRANAMAP_EXOTEL_SID=
# PRANAMAP_EXOTEL_API_KEY=
# PRANAMAP_EXOTEL_API_TOKEN=
# PRANAMAP_EXOTEL_SUBDOMAIN=api.exotel.com
# PRANAMAP_EXOTEL_SENDER_ID=
# WhatsApp Cloud API (Meta). Templates must be approved in WhatsApp Manager with the same names.
# PRANAMAP_WHATSAPP_ENABLED=false
# PRANAMAP_WHATSAPP_PHONE_NUMBER_ID=
# PRANAMAP_WHATSAPP_TOKEN=
# PRANAMAP_PATIENT_CHANNEL=sms
# PRANAMAP_REMINDER_HOURS_BEFORE=24

# --- ABHA / ABDM -----------------------------------------------------------------------------------
# Sandbox credentials from https://sandbox.abdm.gov.in. Empty = format checks only (mock).
# PRANAMAP_ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
# PRANAMAP_ABDM_CLIENT_ID=
# PRANAMAP_ABDM_CLIENT_SECRET=

# --- Voice notes for the doctor --------------------------------------------------------------------
# PRANAMAP_MEDIA_DIR=data/media
# Audio is identifiable: deleted after this many days.
# PRANAMAP_MEDIA_RETENTION_DAYS=60

# --- Teleconsult -----------------------------------------------------------------------------------
# PRANAMAP_JITSI_BASE_URL=https://meet.jit.si
